{
  "name": "ghostpixel",
  "version": "1.0.0",
  "private": true,
  "description": "GhostPixel — 浏览器端图片元数据检查与清理工具，图片永不上传。",
  "type": "module",
  "license": "MIT",
  "author": "0xkillcoin",
  "homepage": "https://iiiiiiiiiiiiiKK.github.io/ghostpixel/",
  "repository": {
    "type": "git",
    "url": "https://github.com/iiiiiiiiiiiiiKK/ghostpixel.git"
  },
  "keywords": [
    "privacy",
    "exif",
    "metadata",
    "gps",
    "image",
    "browser",
    "react",
    "typescript"
  ],
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixtures": "python scripts/make_fixtures.py",
    "verify": "python scripts/verify_cleaned.py"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.3",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
